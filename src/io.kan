def requestGet : CommonObjectRef -> Request := fun (key : CommonObjectRef) => apiMethodApiRequestGetRequest (apiMethodGetRequestMake key)

def requestList : CommonKind -> Bytes -> Request := fun (kind : CommonKind) (ns : Bytes) => apiMethodApiRequestListRequest (apiMethodListRequestMake kind ns)

def requestCreate : Bytes -> DynamicObjectT -> Request := fun (ns : Bytes) (obj : DynamicObjectT) => apiMethodApiRequestCreateRequest (apiMethodCreateRequestMake ns obj)

def requestDelete : CommonObjectRef -> Option ApiMethodPreconditions -> Request := fun (key : CommonObjectRef) (preconditions : Option ApiMethodPreconditions) => apiMethodApiRequestDeleteRequest (apiMethodDeleteRequestMake key preconditions)

def requestUpdate : Bytes -> Bytes -> DynamicObjectT -> Request := fun (ns : Bytes) (name : Bytes) (obj : DynamicObjectT) => apiMethodApiRequestUpdateRequest (apiMethodUpdateRequestMake ns name obj)

def requestUpdateStatus : Bytes -> Bytes -> DynamicObjectT -> Request := fun (ns : Bytes) (name : Bytes) (obj : DynamicObjectT) => apiMethodApiRequestUpdateStatusRequest (apiMethodUpdateStatusRequestMake ns name obj)

def requestGetThenDelete : CommonObjectRef -> OwnerReferenceT -> Request := fun (key : CommonObjectRef) (owner : OwnerReferenceT) => apiMethodApiRequestGetThenDeleteRequest (apiMethodGetThenDeleteRequestMake key owner)

def requestGetThenUpdate : Bytes -> Bytes -> OwnerReferenceT -> DynamicObjectT -> Request := fun (ns : Bytes) (name : Bytes) (owner : OwnerReferenceT) (obj : DynamicObjectT) => apiMethodApiRequestGetThenUpdateRequest (apiMethodGetThenUpdateRequestMake ns name owner obj)

def requestGetThenUpdateStatus : Bytes -> Bytes -> OwnerReferenceT -> DynamicObjectT -> Request := fun (ns : Bytes) (name : Bytes) (owner : OwnerReferenceT) (obj : DynamicObjectT) => apiMethodApiRequestGetThenUpdateStatusRequest (apiMethodGetThenUpdateStatusRequestMake ns name owner obj)
