    match r as self in ApiMethodApiResponse return Option (ApiResult ListDynamicObjectT) with
    | apiMethodApiResponseGetResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseListResponse x => some (ApiResult ListDynamicObjectT) (apiMethodListResponseRes x)
    | apiMethodApiResponseCreateResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseDeleteResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseUpdateResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseUpdateStatusResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseGetThenDeleteResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseGetThenUpdateResponse x => none (ApiResult ListDynamicObjectT)
    | apiMethodApiResponseGetThenUpdateStatusResponse x => none (ApiResult ListDynamicObjectT))

def makeResponseList : ApiResult ListDynamicObjectT -> Response := fun (r : ApiResult ListDynamicObjectT) => apiMethodApiResponseListResponse (apiMethodListResponseMake r)

