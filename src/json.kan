def jsonIsNull : Value -> Bool := fun (j : Value) =>
  match j as self in JsonTree sort return Bool with
  | jsonNull => true
  | jsonBool x => false
  | jsonInt x => false
  | jsonIntLiteral x => false
  | jsonFloat x => false
  | jsonString x => false
  | jsonArray x => false
  | jsonObject x => false
  | jsonArrayNil => false
  | jsonArrayCons h t => false
  | jsonObjectNil => false
  | jsonObjectCons k v t => false

def rec jsonMemberOption : Members -> Bytes -> Option Value := fun (members : Members) (key : Bytes) =>
  match members as self in JsonTree sort return Option Value with
  | jsonNull => none Value
  | jsonBool x => none Value
  | jsonInt x => none Value
  | jsonIntLiteral x => none Value
  | jsonFloat x => none Value
  | jsonString x => none Value
  | jsonArray x => none Value
  | jsonObject x => none Value
  | jsonArrayNil => none Value
  | jsonArrayCons h t => none Value
  | jsonObjectNil => none Value
  | jsonObjectCons k v t => (case (bytesEqual key k) with | 1 (u : Unit) => some Value v | 0 (u : Unit) => jsonMemberOption t key)
