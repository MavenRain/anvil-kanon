def jsonGetInt : Value -> Result Int := fun (j : Value) =>
  match j as self in JsonTree sort return Result Int with
  | jsonNull => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonBool x => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonInt x => ok Int x
  | jsonIntLiteral x => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonFloat x => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonString x => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonArray x => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonObject x => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonArrayNil => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonArrayCons h t => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonObjectNil => err Int (decodeError b"int" b"expected a JSON integer")
  | jsonObjectCons k v t => err Int (decodeError b"int" b"expected a JSON integer")

