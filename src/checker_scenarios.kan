mu ClusterQuery : Type 0 := | queryAlways : ClusterQuery | queryEsr : ClusterQuery | querySettled : ClusterQuery | queryTemporal : ClusterQuery | queryUnique : ClusterQuery
def scenarioCheckerConfig : Bool -> ClusterConfig := fun (stateful : Bool) => select ClusterConfig stateful scenarioStatefulCluster scenarioVrsCluster
def scenarioCheckerSeed : Bool -> ClusterQuery -> Int -> Sequence Int -> ClusterState := fun (stateful : Bool) (query : ClusterQuery) (desired : Int) (desireds : Sequence Int) =>
  match query as self in ClusterQuery return ClusterState with
  | queryAlways => select ClusterState stateful (scenarioStatefulSeed desired false) (scenarioVrsSeed desired false)
  | queryUnique => select ClusterState stateful (scenarioStatefulSeedMulti desireds true) (scenarioVrsSeedMulti desireds true)
  | queryEsr => select ClusterState stateful (scenarioStatefulSeed desired true) (scenarioVrsSeed desired true)
  | querySettled => select ClusterState stateful (scenarioStatefulSeed desired true) (scenarioVrsSeed desired true)
  | queryTemporal => select ClusterState stateful (scenarioStatefulSeed desired true) (scenarioVrsSeed desired true)
def scenarioCheckerTarget : Bool -> Int -> ClusterState -> Bool := fun (stateful : Bool) (desired : Int) =>
  select (ClusterState -> Bool) stateful (vstsCurrentStateMatches (scenarioStateful false desired)) (vrsCurrentStateMatches (scenarioVrs desired))
def scenarioCheckerDesired : Bool -> Int -> ClusterState -> Bool := fun (stateful : Bool) (desired : Int) =>
  select (ClusterState -> Bool) stateful (vstsDesiredStateIs (scenarioStateful false desired)) (vrsDesiredStateIs (scenarioVrs desired))
def checkClusterScenarioWithTarget : Bool -> ClusterQuery -> Int -> Sequence Int -> Int -> Bound -> (ClusterState -> Bool) -> ClusterReport :=
  fun (stateful : Bool) (query : ClusterQuery) (desired : Int) (desireds : Sequence Int) (depth : Int) (b : Bound) (target : ClusterState -> Bool) =>
  let c : ClusterConfig := scenarioCheckerConfig stateful in
  let seed : ClusterState := scenarioCheckerSeed stateful query desired desireds in
  let init : Sequence ClusterState := sequenceSingleton ClusterState seed in
  let r : Reachable ClusterState := clusterExplore depth b c init in
  match query as self in ClusterQuery return ClusterReport with
  | queryAlways => clusterSafetyReport b c r (select Invariants stateful (vstsAlways (scenarioStateful false desired) (nonnegative 0)) (vrsAlways (scenarioVrs desired) (nonnegative 0)))
  | queryEsr => clusterReachesReport b c r target (clusterEffectivelyQuiescent b c)
  | querySettled => clusterReachesReport b c r target (clusterSettled b c)
  | queryUnique => let xs : Invariants := sequenceSlice Invariant (clusterStructural (nonnegative 0)) 5 1 in
      let rep : ClusterReport := clusterSafetyReport b c r xs in tuple (rep.0, rep.1, rep.2, rep.3, rep.4, rep.5,
        some Nat (reachableCount ClusterState r (fun (s : ClusterState) => natLt 1 (ongoingMapSize (assuranceOngoing (nonnegative 0) s)))))
  | queryTemporal =>
      let key : Bytes := select Bytes stateful b"vsts1/ns" b"vrs1/ns" in
      let goal : Formula ClusterState := esrPerCr key (scenarioCheckerDesired stateful desired) target in
      let gate : ClusterState -> Bool := clusterEffectivelyQuiescent b c in
      let fairGate : ClusterState -> Bool := select (ClusterState -> Bool) stateful (clusterSettled b c) gate in
      let outcome : Outcome ClusterState := checkTemporal ClusterState depth (boundedSuccessors b c) clusterStateEqual init (clusterFairLasso fairGate) (formulaHolds ClusterState goal) in
      let meta : ClusterMetadata := clusterCollectMetadata b c r in tuple (outcome, b, meta.0, meta.1, meta.2, none Invariant, some Nat (reachableCount ClusterState r gate))
def checkClusterScenario : Bool -> ClusterQuery -> Int -> Sequence Int -> Int -> Bound -> ClusterReport :=
  fun (stateful : Bool) (query : ClusterQuery) (desired : Int) (desireds : Sequence Int) (depth : Int) (b : Bound) =>
    checkClusterScenarioWithTarget stateful query desired desireds depth b (scenarioCheckerTarget stateful desired)
