def rec proofSyntax : ProofFormula -> Value := fun (p : ProofFormula) => match p as self in ProofFormula return Value with
  | proofTt  => jsonArray (jsonArrayCons (jsonString b"tt") (jsonArrayNil))
  | proofFf  => jsonArray (jsonArrayCons (jsonString b"ff") (jsonArrayNil))
  | proofState name pred => jsonArray (jsonArrayCons (jsonString b"state") (jsonArrayCons (jsonString name) (jsonArrayNil)))
  | proofAction name act => jsonArray (jsonArrayCons (jsonString b"action") (jsonArrayCons (jsonString name) (jsonArrayNil)))
  | proofConj a b => jsonArray (jsonArrayCons (jsonString b"conj") (jsonArrayCons (proofSyntax a) (jsonArrayCons (proofSyntax b) (jsonArrayNil))))
  | proofDisj a b => jsonArray (jsonArrayCons (jsonString b"disj") (jsonArrayCons (proofSyntax a) (jsonArrayCons (proofSyntax b) (jsonArrayNil))))
  | proofImpl a b => jsonArray (jsonArrayCons (jsonString b"impl") (jsonArrayCons (proofSyntax a) (jsonArrayCons (proofSyntax b) (jsonArrayNil))))
  | proofNeg a => jsonArray (jsonArrayCons (jsonString b"neg") (jsonArrayCons (proofSyntax a) (jsonArrayNil)))
  | proofLater a => jsonArray (jsonArrayCons (jsonString b"later") (jsonArrayCons (proofSyntax a) (jsonArrayNil)))
  | proofNext a => jsonArray (jsonArrayCons (jsonString b"next") (jsonArrayCons (proofSyntax a) (jsonArrayNil)))
  | proofAlways a => jsonArray (jsonArrayCons (jsonString b"always") (jsonArrayCons (proofSyntax a) (jsonArrayNil)))
  | proofEventually a => jsonArray (jsonArrayCons (jsonString b"eventually") (jsonArrayCons (proofSyntax a) (jsonArrayNil)))
def kernelFixtures : Nat -> Bytes := fun (u : Nat) =>
  let sp : ProofFormula := proofTt in let p : ProofFormula := proofState b"p" (fun (s : ClusterState) => true) in let q : ProofFormula := proofState b"q" (fun (s : ClusterState) => true) in let r : ProofFormula := proofState b"r" (fun (s : ClusterState) => true) in
  let f : ProofFact := proofAssume sp (proofLeadsTo p q) in let g : ProofFact := proofAssume sp (proofLeadsTo q r) in
  let pp : ProofFact := proofAssume sp (proofAlways (proofImpl p p)) in let qq : ProofFact := proofAssume sp (proofAlways (proofImpl q q)) in
  let an : ProofFact := proofAssume sp (proofAlways (proofAction b"next" (fun (s : ClusterState) (t : ClusterState) => true))) in
  let pe : ProofFact := proofAssume sp (proofAlways (proofImpl p q)) in let fair : ProofFact := proofAssume sp (proofLeadsTo (proofAlways q) r) in
  valueRender (jsonArray (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofTrans f g)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofTrans f (proofAssume proofFf g.1))) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofTrans f f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofTrans (proofAssume sp p) g)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofOr f (proofAssume sp (proofLeadsTo r q)))) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofOr f g)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofApply (proofAssume sp p) f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofApply (proofAssume sp q) f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofBorrow (proofAssume sp (proofAlways q)) (proofAssume sp (proofLeadsTo (proofConj p q) r)))) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofBorrow (proofAssume sp (proofAlways r)) (proofAssume sp (proofLeadsTo (proofConj p q) r)))) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofBorrow (proofAssume sp (proofAlways r)) f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWeaken pp qq f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWeaken f qq f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWeaken pp f f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWeaken qq pp f)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofInitInvariant sp p (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) (proofAssume sp p) an)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofInitInvariant sp p (fun (u : Ghost) => ok Bool false) (fun (u : Ghost) => ok Bool true) (proofAssume sp p) an)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofInitInvariant sp p (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool false) (proofAssume sp p) an)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p q (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) an pe fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p q (fun (u : Ghost) => ok Bool false) (fun (u : Ghost) => ok Bool true) an pe fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p q (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool false) an pe fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp sp q (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) an pe fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p sp (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) an pe fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p q (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) f pe fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p q (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) an f fair)) (jsonArrayCons (proofResultEncode ProofFact (fun (f : ProofFact) => proofSyntax f.1) (proofWf1 sp p q (fun (u : Ghost) => ok Bool true) (fun (u : Ghost) => ok Bool true) an pe f)) (jsonArrayNil))))))))))))))))))))))))))))
