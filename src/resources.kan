def vreplicaSetTControllerOwner : VreplicaSetT -> Option OwnerReferenceT := fun (x : VreplicaSetT) =>
  let m : ObjectMetaT := vreplicaSetTMetadata x in
  optionBind Bytes OwnerReferenceT (objectMetaTName m) (fun (name : Bytes) =>
    optionMap Int OwnerReferenceT (fun (uid : Int) => ownerReferenceTMake (some Bool true) (some Bool true) vreplicaSetTKind name uid) (objectMetaTUid m))

