-- Resource marshal/unmarshal contracts, including kind and null checks.

def decodeResourceObject : (0 A : Type 0) -> Bytes -> Bytes -> (Value -> Result A) -> Value -> Result A :=
  fun (0 A : Type 0) (label : Bytes) (detail : Bytes) (decode : Value -> Result A) (v : Value) =>
  case (jsonGetObject v) with | 0 (e : Error) => err A (decodeError label detail) | 1 (m : Members) => decode v
def decodeResourceOptional : (0 A : Type 0) -> Bytes -> (Value -> Result A) -> Value -> Result (Option A) :=
  fun (0 A : Type 0) (label : Bytes) (decode : Value -> Result A) (v : Value) =>
  case (jsonIsNull v) with | 1 (u : Unit) => ok (Option A) (none A)
  | 0 (u : Unit) => resultMap A (Option A) (fun (x : A) => some A x) (decodeResourceObject A label b"expected object or null" decode v)
def decodeResourceNull : Bytes -> Value -> Result Ghost := fun (label : Bytes) (v : Value) =>
  case (jsonIsNull v) with | 1 (u : Unit) => ok Ghost ghost | 0 (u : Unit) => err Ghost (decodeError label b"expected null")
def encodeResourceNull : Ghost -> Value := fun (x : Ghost) => jsonNull


def podTKind : CommonKind := commonKindPod

def podTMarshalSpec : Option PodSpecT -> Value := fun (x : Option PodSpecT) => jsonEncodeOption PodSpecT (podSpecTEncode) x

def podTUnmarshalSpec : Value -> Result (Option PodSpecT) := fun (x : Value) => decodeResourceOptional PodSpecT b"pod.spec" (podSpecTDecode) x

def podTMarshalStatus : Option Ghost -> Value := fun (x : Option Ghost) => jsonEncodeOption Ghost (jsonEncodeGhost) x

def podTUnmarshalStatus : Value -> Result (Option Ghost) := fun (x : Value) => decodeResourceOptional Ghost b"pod.status" (jsonDecodeGhost) x

def podTMarshal : PodT -> DynamicObjectT := fun (x : PodT) =>
  dynamicObjectTMake podTKind (podTMetadata x) (podTMarshalSpec (podTSpec x)) (podTMarshalStatus (podTStatus x))

def podTUnmarshal : DynamicObjectT -> Result PodT := fun (x : DynamicObjectT) =>
  case (commonKindEqual (dynamicObjectTKind x) podTKind) with
  | 0 (u : Unit) => err PodT (kindMismatch (kindShow podTKind) (kindShow (dynamicObjectTKind x)))
  | 1 (u : Unit) => resultBind (Option PodSpecT) PodT (podTUnmarshalSpec (dynamicObjectTSpec x)) (fun (spec : Option PodSpecT) =>
    resultMap (Option Ghost) PodT (fun (status : Option Ghost) => podTMake (dynamicObjectTMetadata x) spec status) (podTUnmarshalStatus (dynamicObjectTStatus x)))

