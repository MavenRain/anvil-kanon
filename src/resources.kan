  | 1 (u : Unit) => resultBind (Option StatefulSetSsSpec) StatefulSetT (statefulSetTUnmarshalSpec (dynamicObjectTSpec x)) (fun (spec : Option StatefulSetSsSpec) =>
    resultMap (Option StatefulSetSsStatus) StatefulSetT (fun (status : Option StatefulSetSsStatus) => statefulSetTMake (dynamicObjectTMetadata x) spec status) (statefulSetTUnmarshalStatus (dynamicObjectTStatus x)))

