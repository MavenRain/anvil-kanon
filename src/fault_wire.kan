-- Generated wire representation for bounded fault reports.
def faultQueryDecode : Value -> Result FaultQuery := fun (j : Value) => resultBind Bytes FaultQuery (jsonGetString j) (fun (name : Bytes) => (case (bytesEqual name b"always") with | 1 (u : Unit) => ok FaultQuery faultQueryAlways | 0 (u : Unit) => (case (bytesEqual name b"correspondence") with | 1 (u : Unit) => ok FaultQuery faultQueryCorrespondence | 0 (u : Unit) => (case (bytesEqual name b"reconcile") with | 1 (u : Unit) => ok FaultQuery faultQueryReconcile | 0 (u : Unit) => (case (bytesEqual name b"responseRv") with | 1 (u : Unit) => ok FaultQuery faultQueryResponseRv | 0 (u : Unit) => (case (bytesEqual name b"responseMatched") with | 1 (u : Unit) => ok FaultQuery faultQueryResponseMatched | 0 (u : Unit) => (case (bytesEqual name b"store") with | 1 (u : Unit) => ok FaultQuery faultQueryStore | 0 (u : Unit) => (case (bytesEqual name b"helper") with | 1 (u : Unit) => ok FaultQuery faultQueryHelper | 0 (u : Unit) => (case (bytesEqual name b"unique") with | 1 (u : Unit) => ok FaultQuery faultQueryUnique | 0 (u : Unit) => (case (bytesEqual name b"settles") with | 1 (u : Unit) => ok FaultQuery faultQuerySettles | 0 (u : Unit) => (case (bytesEqual name b"provenance") with | 1 (u : Unit) => ok FaultQuery faultQueryProvenance | 0 (u : Unit) => (case (bytesEqual name b"rely") with | 1 (u : Unit) => ok FaultQuery faultQueryRely | 0 (u : Unit) => (case (bytesEqual name b"forge") with | 1 (u : Unit) => ok FaultQuery faultQueryForge | 0 (u : Unit) => (case (bytesEqual name b"internal") with | 1 (u : Unit) => ok FaultQuery faultQueryInternal | 0 (u : Unit) => (case (bytesEqual name b"scaleDown") with | 1 (u : Unit) => ok FaultQuery faultQueryScaleDown | 0 (u : Unit) => (case (bytesEqual name b"localBinding") with | 1 (u : Unit) => ok FaultQuery faultQueryLocalBinding | 0 (u : Unit) => (case (bytesEqual name b"statePredicates") with | 1 (u : Unit) => ok FaultQuery faultQueryStatePredicates | 0 (u : Unit) => err FaultQuery (decodeError b"fault query" name))))))))))))))))))
def faultBudgetDecode : Value -> Result FaultBudget := fun (j : Value) => resultBind (Int) FaultBudget (jsonField (Int) j b"maxCrashes" (jsonGetInt)) (fun (f0 : Int) => resultBind (Int) FaultBudget (jsonField (Int) j b"maxDrops" (jsonGetInt)) (fun (f1 : Int) => resultBind (Int) FaultBudget (jsonField (Int) j b"maxMonkeyOps" (jsonGetInt)) (fun (f2 : Int) => ok FaultBudget (tuple (f0, f1, f2)))))
def faultOptionsDecode : Value -> Result FaultOptions := fun (j : Value) => resultBind (Int) FaultOptions (jsonField (Int) j b"desired" (jsonGetInt)) (fun (f0 : Int) => resultBind (Sequence Int) FaultOptions (jsonField (Sequence Int) j b"desireds" (jsonSequenceDecode Int jsonGetInt)) (fun (f1 : Sequence Int) => resultBind (Sequence Int) FaultOptions (jsonField (Sequence Int) j b"ordinals" (jsonSequenceDecode Int jsonGetInt)) (fun (f2 : Sequence Int) => resultBind (Bool) FaultOptions (jsonField (Bool) j b"drop" (jsonGetBool)) (fun (f3 : Bool) => resultBind (Bool) FaultOptions (jsonField (Bool) j b"monkey" (jsonGetBool)) (fun (f4 : Bool) => resultBind (Bool) FaultOptions (jsonField (Bool) j b"vct" (jsonGetBool)) (fun (f5 : Bool) => resultBind (Bool) FaultOptions (jsonField (Bool) j b"requireFault" (jsonGetBool)) (fun (f6 : Bool) => ok FaultOptions (tuple (f0, f1, f2, f3, f4, f5, f6)))))))))
def faultBudgetEncode : FaultBudget -> Value := fun (b : FaultBudget) => jsonObject (jsonObjectCons b"maxCrashes" (jsonInt b.0) (jsonObjectCons b"maxDrops" (jsonInt b.1) (jsonObjectCons b"maxMonkeyOps" (jsonInt b.2) (jsonObjectNil))))
def faultedEncode : Faulted -> Value := fun (f : Faulted) => jsonObject (jsonObjectCons b"state" (clusterStateWireEncode f.0) (jsonObjectCons b"crashes" (jsonInt f.1) (jsonObjectCons b"drops" (jsonInt f.2) (jsonObjectCons b"monkeys" (jsonInt f.3) (jsonObjectNil)))))
def faultOutcomeEncode : Outcome Faulted -> Value := fun (o : Outcome Faulted) => case o with
  | 0 (r : prod (Lasso Faulted, Nat)) => jsonObject (jsonObjectCons b"tag" (jsonString b"refuted") (jsonObjectCons b"stem" (jsonSequenceEncode Faulted faultedEncode r.0.0) (jsonObjectCons b"loop" (jsonSequenceEncode Faulted faultedEncode r.0.1) (jsonObjectCons b"steps" (jsonEncodeNat r.1) (jsonObjectNil)))))
  | 1 (r : prod (Bool, Int, Nat)) => jsonObject (jsonObjectCons b"tag" (jsonString b"noCounterexample") (jsonObjectCons b"decisive" (jsonBool r.0) (jsonObjectCons b"depth" (jsonInt r.1) (jsonObjectCons b"states" (jsonEncodeNat r.2) (jsonObjectNil)))))
def faultReportEncode : FaultReport -> Value := fun (r : FaultReport) => jsonObject (jsonObjectCons b"outcome" (faultOutcomeEncode r.0) (jsonObjectCons b"bound" (boundWireEncode r.1) (jsonObjectCons b"budget" (faultBudgetEncode r.2) (jsonObjectCons b"maxUidSeen" (jsonInt r.3.0) (jsonObjectCons b"maxRvSeen" (jsonInt r.3.1) (jsonObjectCons b"maxCrashesSeen" (jsonInt r.3.2) (jsonObjectCons b"maxDropsSeen" (jsonInt r.3.3) (jsonObjectCons b"maxMonkeysSeen" (jsonInt r.3.4) (jsonObjectCons b"prunedByCeiling" (jsonBool r.3.8) (jsonObjectCons b"prunedByBudget" (jsonBool r.3.9) (jsonObjectCons b"violated" (jsonEncodeOption Invariant invariantIdentityEncode r.4) (jsonObjectCons b"gateStates" (jsonEncodeOption Nat jsonEncodeNat r.5) (jsonObjectCons b"crashWitnessStates" (jsonEncodeNat r.3.5) (jsonObjectCons b"faultFreeStates" (jsonEncodeNat r.3.6) (jsonObjectCons b"settledWithFaultsLive" (jsonEncodeNat r.3.7) (jsonObjectNil))))))))))))))))
def faultCheckInvoke : Value -> Result Value := fun (j : Value) =>
  resultBind FaultQuery Value (jsonField FaultQuery j b"query" faultQueryDecode) (fun (q : FaultQuery) =>
  resultBind Int Value (jsonField Int j b"depth" jsonGetInt) (fun (depth : Int) =>
  resultBind Bound Value (jsonField Bound j b"bound" boundWireDecode) (fun (b : Bound) =>
  resultBind FaultBudget Value (jsonField FaultBudget j b"budget" faultBudgetDecode) (fun (budget : FaultBudget) =>
  resultMap FaultOptions Value (fun (o : FaultOptions) => faultReportEncode (checkFaultScenario q depth b budget o)) (jsonField FaultOptions j b"options" faultOptionsDecode)))))
def faultCheckRender : Value -> Bytes := fun (j : Value) => case (faultCheckInvoke j) with
  | 0 (e : Error) => bytesAppend b"error: " (errorText e) | 1 (j : Value) => valueRender j
def faultForgeRender : Int -> Bool -> Bytes := fun (desired : Int) (respecting : Bool) => valueRender (podTResourceEncode (select PodT respecting (faultRelyRespectingForge desired) (faultRelyViolatingForge desired)))
